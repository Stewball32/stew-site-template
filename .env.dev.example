# ── DEV tier env — copy to `.env.dev` (gitignored), OPTIONAL ──────────────────
# Sourced by ./run-dev.sh if present. Dev runs from the working tree (no
# container): Air hot-reloads the Go/PocketBase backend, Vite serves the
# frontend with HMR and proxies /api to the backend.
#
# run-dev.sh has sane defaults for everything here — this file is only needed to
# override ports/host or to supply secrets for local testing.

# ── Ports (from this project's PORTS.md block) ────────────────────────────────
# Backend (Air/PocketBase). Internal — Vite proxies to it; not tunnel-exposed.
DEV_PB_PORT=8092

# Vite dev server. THIS is the port the cloudflared tunnel points at for dev.
DEV_VITE_PORT=8093

# Public hostname the dev tier is served on. Added to Vite's allowedHosts and
# used for the wss HMR back-channel (clientPort 443) so HMR works through the
# tunnel. Leave blank for pure localhost dev.
DEV_ALLOWED_HOST=

# ── Dev superuser (dev build tag seeds this) ──────────────────────────────────
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# ── Discord bot ───────────────────────────────────────────────────────────────
# There is no DISCORD_BOT_TOKEN here on purpose. The dev build (`-tags dev`, which
# run-dev.sh uses) COMPILES THE BOT SUBSYSTEM OUT — internal/disgo.SubsystemEnabled
# is false, so a dev-tier server never opens a gateway and there is nothing to
# configure. Run the bot on the test (pre) tier and up — see docs/DEPLOYMENTS.md.

# ── OAuth2 (optional, for local login testing) ────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
