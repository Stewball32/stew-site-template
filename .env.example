# ── PROD tier env — copy to `.env` (gitignored) ───────────────────────────────
# Loaded by compose.yml via env_file, so every value here reaches the container's
# process env. Apply changes with `./deploy-prod.sh` (recreates the container;
# `docker compose restart` does NOT re-read env_file).
#
# Tier env files:  .env (prod) · .env.pre (test) · .env.dev (dev, optional)

# ── Ports ─────────────────────────────────────────────────────────────────────
# Host port this tier publishes on (loopback). Take it from this project's block
# in PORTS.md. The container always listens on 8090 internally.
PROD_PB_PORT=8090

# The app's own port var: read by cmd/server (self-bind) and by SvelteKit/typegen
# via $env/static/public. Inside the container the Containerfile pins the listen
# port to 8090, so keep this at 8090 for container tiers.
PUBLIC_PB_PORT=8090

# ── Superuser bootstrap (all builds) ──────────────────────────────────────────
# Set both to auto-create/sync a PocketBase superuser on boot — no hardcoded
# password, no interactive `superuser upsert`. Idempotent. Leave blank to skip.
SEED_SUPERUSER_EMAIL=
SEED_SUPERUSER_PASSWORD=

# ── Dev Superuser (DEV BUILD ONLY) ────────────────────────────────────────────
# Seeds via the `dev` build tag on `task dev`, and used by `task typegen`.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# ── Discord Bot (optional) ────────────────────────────────────────────────────
# Server runs fine without these — you'll see a warning log and bot features
# stay disabled. Set both to enable the bot.
#
# Convention: run the bot on ONE tier at a time. A Discord token allows a single
# gateway connection, so prod and test must not share a token — give the test
# tier its own bot application.
DISCORD_BOT_TOKEN=
DISCORD_DEV_GUILD_ID=

# ── OAuth2 Providers (optional) ───────────────────────────────────────────────
# Leave both fields blank to disable a provider. Set ID + secret to enable.
# Providers listed alphabetically.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
