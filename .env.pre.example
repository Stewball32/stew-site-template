# ── TEST tier ("pre") env — copy to `.env.pre` (gitignored) ───────────────────
# Loaded by compose.pre.yml via env_file. Apply changes with `./deploy-pre.sh`
# (recreates the container; `restart` does NOT re-read env_file).
#
# This file is STANDALONE — it does NOT inherit `.env`. Anything the test tier
# needs must be repeated here.

# ── Ports ─────────────────────────────────────────────────────────────────────
# Host port for the test tier (loopback). From this project's PORTS.md block —
# must differ from PROD_PB_PORT. Container still listens on 8090 internally.
PRE_PB_PORT=8091

PUBLIC_PB_PORT=8090

# ── Superuser bootstrap ───────────────────────────────────────────────────────
# Give the test tier its own admin login (do NOT reuse prod's).
SEED_SUPERUSER_EMAIL=
SEED_SUPERUSER_PASSWORD=

# ── Discord Bot (optional) ────────────────────────────────────────────────────
# If the bot runs on this tier, it needs its OWN application/token — a token
# supports one gateway connection, so it cannot be shared with prod.
# DISCORD_DEV_GUILD_ID gives instant (guild-scoped) slash-command registration.
DISCORD_BOT_TOKEN=
DISCORD_DEV_GUILD_ID=

# ── OAuth2 Providers (optional) ───────────────────────────────────────────────
# Use test-tier credentials with this tier's callback URLs where possible.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
